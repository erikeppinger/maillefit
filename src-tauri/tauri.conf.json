{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MailleFit",
  "version": "0.5.3",
  "identifier": "app.chainmail-designer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MailleFit",
        "width": 1320,
        "height": 880,
        "minWidth": 380,
        "minHeight": 500
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Design chainmail garments from body measurements",
    "category": "Utility",
    "windows": {
      "wix": { "language": "en-US" }
    }
  }
}
